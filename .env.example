# ===================================================================
# Variaveis de Ambiente - Gerenciador de Vendas de Agua Mineral
# Copie este arquivo para .env ao executar em ambiente local ou staging
# ===================================================================

# Perfil do Spring Boot (local, staging, prod)
SPRING_PROFILES_ACTIVE=prod

# Porta HTTP da API
SERVER_PORT=8080

# Banco de Dados PostgreSQL
DB_HOST=localhost
DB_PORT=5432
DB_NAME=vendas_agua
DB_USER=postgres
DB_PASS=postgres

# Cache e Idempotencia Redis
REDIS_HOST=localhost
REDIS_PORT=6379

# Feature Flags em Tempo de Execucao (true / false)
FEATURE_FISCAL_RECEIPT_PREVIEW=true
FEATURE_FREE_DELIVERY_PROMO=false

# Observabilidade Prometheus & Grafana (Opcional - padroes definidos no Compose)
PROMETHEUS_PORT=9090
GRAFANA_PORT=3000
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=admin

